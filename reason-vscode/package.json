{
  "name": "reason-vscode",
  "displayName": "reason-vscode",
  "description": "Frontend for Reason AI Architect",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reason-vscode.helloWorld",
        "title": "Hello World"
      }
    ],
    "chatParticipants": [
      {
        "id": "reasonmcp.chat",
        "name": "reason",
        "fullName": "Reason Architect",
        "description": "Your deterministic AI software architect",
        "isSticky": true
      },
      {
        "id": "bella.chat",
        "name": "bella",
        "fullName": "Reason Architect",
        "description": "Your aloof chocolate labrador coding companin",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "eslint": "^9.36.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.3",
    "webpack-cli": "^6.0.1"
  }
}
