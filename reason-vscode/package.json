{
  "name": "reason-vscode",
  "displayName": "reason-vscode",
  "description": "Frontend for Reason AI Architect",
  "version": "0.0.2",
  "enabledApiProposals": [
    "languageModelSystem",
    "chatContextProvider",
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatOutputRenderer",
    "chatSessionCustomizationProvider",
    "chatSessionsProvider",
    "contribChatEditorInlineGutterMenu",
    "contribEditorContentMenu",
    "contribMenuBarHome",
    "contribStatusBarItems",
    "contribSourceControlInputBoxMenu",
    "contribViewContainerTitle",
    "defaultChatParticipant",
    "taskExecutionTerminal"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "reason-vscode.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "browseAndAttachExternal",
        "title": "Browse External Folder",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "editor/context/chat": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "chat/chatSessions": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "editor/title": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "chat/contextUsage/actions": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "chat/editor/inlineGutter": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "chat/customizations/item": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "chat/customizations/create": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "view/item/context": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "view/title": [
        {
          "command": "browseAndAttachExternal",
          "when": "true",
          "group": "chat"
        }
      ],
      "viewContainer/title": [
        {
          "command": "browseAndAttachExternal",
          "when": "viewContainer == workbench.view.debug",
          "group": "chat"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "reasonmcp.chat",
        "name": "reason",
        "fullName": "Reason Architect",
        "description": "Your deterministic AI software architect",
        "isSticky": true
      },
      {
        "id": "bella.chat",
        "name": "bella",
        "fullName": "Labrador Companion",
        "description": "Your aloof chocolate labrador coding companion",
        "isSticky": true
      },
      {
        "id": "esper.chat",
        "name": "esper",
        "fullName": "Esper from Blade Runner",
        "description": "Esper takes one specific file you hand it, dissects it, extracts the tags/text, and returns the exact context you need.",
        "isSticky": true
      },
      {
        "id": "mozzie.chat",
        "name": "mozzie",
        "fullName": "Archival Specialist",
        "description": "Agent specialized in indexing and enriching documents",
        "isSticky": true
      },
      {
        "id": "tank.chat",
        "name": "tank",
        "fullName": "Playbook Processor",
        "description": "Agent specialized in processing Playbooks and dispatch Agentic work",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "browseExternalContext",
        "displayName": "browseExternalContext",
        "modelDescription": "browseExternalContext",
        "name": "browseExternalContext",
        "tags": [
          "reasonmcp-chat-tools",
          "browseAndAttachExternal",
          "browseExternalContext"
        ],
        "icon": "$(folder-opened)",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@types/vscode": "^1.137.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "ajv": "^8.20.0",
    "ajv-keywords": "^5.1.0",
    "eslint": "^9.36.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "webpack": "^5.108.3",
    "webpack-cli": "^6.0.1"
  }
}