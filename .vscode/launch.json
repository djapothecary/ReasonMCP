{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Launch ReasonMCP.Server (MCP Backend)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build solution",
      "program": "${workspaceFolder}/ReasonMCP.Server/bin/Debug/net10.0/win-x64/ReasonMCP.Server.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ReasonMCP.Server",
      //"console":"externalTerminal"
      "console": "internalConsole",
      "stopAtEntry": false,
      "requireExactSource": false
    },
    {
      "name": "2. Launch ReasonMCP.Console (MLOps / Data Factory)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build solution",
      "program": "${workspaceFolder}/ReasonMCP.Console/bin/Debug/net10.0/win-x64/ReasonMCP.Console.dll",
      "args": [],
      "cwd": "${workspaceFolder}/ReasonMCP.Console",
      "console": "externalTerminal",
      "stopAtEntry": false,
      "requireExactSource": false
    },
    {
      "name": "3. Attach to Running Server",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
